# {{ ansible_managed }}
[Unit]
Description=Todolist Django (Gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ app_user }}
Group={{ app_user }}
WorkingDirectory={{ app_dir }}
ExecStart={{ venv_dir }}/bin/gunicorn --workers 2 --bind 0.0.0.0:80 todo.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=3

# Port 80 sans root : uniquement le droit d'écouter sur un port < 1024
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# Bac à sable : système en lecture seule, sauf le dossier de l'application
ProtectSystem=strict
ReadWritePaths={{ app_dir }}
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
